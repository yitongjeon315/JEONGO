# 한 줄 연결 문자열을 사용하거나 아래 DB_* 값을 사용하세요.
# DATABASE_URL=mysql://jeongo:change-me@127.0.0.1:3306/jeongo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jeongo
DB_PASSWORD=change-me
DB_NAME=jeongo

# AI 튜터, 번역, 중국어 음성 전사
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# 현실 보상 수신 번호 암호화 키(운영 환경에서 24자 이상의 임의 문자열로 교체)
REDEMPTION_ENCRYPTION_KEY=replace-with-at-least-24-random-characters

# 정밀 성조 분석 공급자를 연결할 때 사용(선택). 공급자 API가 transcript,
# pronunciationScore, fluencyScore, words, pitch curves를 JSON으로 반환해야 합니다.
PRONUNCIATION_ANALYSIS_URL=
PRONUNCIATION_ANALYSIS_KEY=
